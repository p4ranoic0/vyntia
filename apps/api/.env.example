# ============================================================================
# VYNTIA - VARIABLES DE AMBIENTE
# ============================================================================
# Copiar este archivo a .env y configurar según tu ambiente

# ============================================================================
# DJANGO CORE
# ============================================================================

# Modo DEBUG - Nunca activar en producción
DEBUG=True

# Clave secreta de Django - Generar una segura en producción
# Ejecutar: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-tu-clave-super-secreta-cambiar-en-produccion

# Hosts permitidos (separados por comas)
ALLOWED_HOSTS=localhost,127.0.0.1,*.vyntia.local

# URL del frontend para CORS y redirects
FRONTEND_URL=http://localhost:5173

# ============================================================================
# BASE DE DATOS - PostgreSQL
# ============================================================================

# Motor de base de datos
DB_ENGINE=django.db.backends.postgresql

# Nombre de la base de datos
DB_NAME=bd_vyntia

# Usuario de PostgreSQL
DB_USER=postgres

# Contraseña del usuario (no incluir caracteres especiales sin escapar)
# Ejemplo con accento: Demenci4@ → se escapa automáticamente
DB_PASSWORD=tu_password_postgresql

# Host del servidor PostgreSQL
DB_HOST=localhost

# Puerto de PostgreSQL
DB_PORT=5432

# Pool de conexiones (opcional)
DB_CONN_MAX_AGE=600
DB_AUTOCOMMIT=True

# ============================================================================
# AUTENTICACIÓN & SEGURIDAD JWT
# ============================================================================

# Duración del token de acceso (segundos)
JWT_ACCESS_TOKEN_LIFETIME=3600

# Duración del token de refresco (segundos)
JWT_REFRESH_TOKEN_LIFETIME=604800

# Algoritmo de firmado
JWT_ALGORITHM=HS256

# Secreto JWT (usar igual a SECRET_KEY o diferente)
JWT_SECRET=tu-clave-jwt-super-segura

# ============================================================================
# REDIS (Cache y Celery)
# ============================================================================

# URL de redis para cache (LocMemCache local)
CACHE_URL=redis://127.0.0.1:6379/0

# URL de redis para Celery (cola de tareas)
CELERY_REDIS_URL=redis://127.0.0.1:6379/1
REDIS_URL=redis://127.0.0.1:6379/0

# ============================================================================
# EMAILS
# ============================================================================

# Backend de emails
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Servidor SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Usar TLS
EMAIL_USE_TLS=True

# Credenciales SMTP
EMAIL_HOST_USER=tu@email.com
EMAIL_HOST_PASSWORD=tu_password_smtp

# Email por defecto
DEFAULT_FROM_EMAIL=noreply@vyntia.com

# ============================================================================
# LOGGING & MONITOREO
# ============================================================================

# Nivel de log
LOG_LEVEL=INFO

# Ruta de logs
LOG_DIR=logs

# ============================================================================
# CARACTERISTICAS OPCIONALES
# ============================================================================

# Sentry (error tracking)
SENTRY_DSN=""

# Azure Blob Storage (archivos)
AZURE_STORAGE_ENABLED=False
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_CONTAINER_NAME=""
AZURE_ACCOUNT_KEY=""

# ============================================================================
# DESARROLLO LOCAL
# ============================================================================

# Estar en desarrollo
ENVIRONMENT=development

# Permitir CORS de cualquier origen (SOLO en desarrollo)
CORS_ALLOW_ALL_ORIGINS=True

# Mostrar SQL queries en logs
SQL_DEBUG=False

# ============================================================================
# NOTAS
# ============================================================================
# - DB_PASSWORD: Si contiene caracteres especiales (@, #, etc.), escapar en .env
# - SECRET_KEY: Generar una única segura en producción
# - JWT_SECRET: Usar igual a SECRET_KEY o generar una diferente
# - EMAILS: Configurar con cuenta SMTP válida (Gmail, SendGrid, etc.)
# - REDIS: Requerir Redis corriendo en localhost:6379 (opcional)
