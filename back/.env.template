# -----------------------------
# Core Django
# -----------------------------
# Required in all environments.
SECRET_KEY=replace-with-a-secure-secret-key
DJANGO_SETTINGS_MODULE=config.settings.development

# Frontend URL used in password reset links and notifications.
# Dev default: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# -----------------------------
# Database (PostgreSQL)
# -----------------------------
# Required in development and production.
DB_NAME=bd_rrhh_intranet
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=10
DB_TEST_NAME=test_bd_rrhh_intranet

# Optional read-replica settings (production).
DB_READ_NAME=bd_rrhh_intranet
DB_READ_USER=postgres
DB_READ_PASSWORD=change-me
DB_READ_HOST=localhost
DB_READ_PORT=5432
DB_READ_SSLMODE=prefer

# -----------------------------
# Hosts and CORS
# -----------------------------
# Comma-separated values.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------
# Cache and Sessions
# -----------------------------
# General fallback Redis URL.
REDIS_URL=redis://127.0.0.1:6379/1
# Dedicated Redis DB for Django cache/session data.
CACHE_REDIS_URL=redis://127.0.0.1:6379/0
# Dedicated Redis DB for Celery broker/result backend.
CELERY_REDIS_URL=redis://127.0.0.1:6379/1

# -----------------------------
# Email (SMTP)
# -----------------------------
# Required in production only.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Intranet RRHH <no-reply@example.com>

# -----------------------------
# Storage (S3) - optional
# -----------------------------
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1

# -----------------------------
# Security and Operations
# -----------------------------
# Optional custom admin path in production.
ADMIN_URL=admin/
